{
  "schemaVersion": 1,
  "id": "keycps",
  "version": "${version}",
  "name": "KeyCPS",
  "description": "A clean keystrokes and CPS overlay: WASD, jump, sneak, sprint, attack and use, with live clicks-per-second (keyboard key-repeat included). Follows your key bindings, fully configurable, draggable.",
  "authors": ["Lucas"],
  "contact": {
    "homepage": "https://modrinth.com/mod/keycps"
  },
  "license": "MIT",
  "icon": "icon.png",
  "environment": "client",
  "entrypoints": {
    "client": ["com.keyshow.KeyShowMod"],
    "modmenu": ["com.keyshow.ModMenuIntegration"]
  },
  "mixins": ["keycps.mixins.json"],
  "depends": {
    "fabricloader": ">=0.15.0",
    "minecraft": "${minecraft_version}",
    "java": ">=${java_version}",
    "fabric-api": "*"
  },
  "suggests": {
    "modmenu": "*"
  },
  "custom": {
    "modmenu": {
      "links": {
        "modmenu.modrinth": "https://modrinth.com/mod/keycps"
      }
    }
  }
}
